<plist version="1.0">
<dict><key>fileTypes</key><array><string>asm</string><string>esp</string><string>gasm</string><string>def</string></array><key>name</key><string>PC/GEOS ESP assembly</string><key>patterns</key><array><dict><key>include</key><string>#comments</string></dict><dict><key>include</key><string>#strings</string></dict><dict><key>match</key><string>^\s*[A-Za-z_?$@][\w?$@]*(?=\s+(?i:proc|method)\b)</string><key>name</key><string>entity.name.function.esp</string></dict><dict><key>match</key><string>^\s*[A-Za-z_?$@][\w?$@]*(?=\s+(?i:class|struct|record|segment)\b)</string><key>name</key><string>entity.name.type.esp</string></dict><dict><key>match</key><string>^\s*[A-Za-z_?$@][\w?$@]*:{1,2}</string><key>name</key><string>entity.name.label.esp</string></dict><dict><key>include</key><string>#symbols</string></dict><dict><key>include</key><string>#numbers</string></dict><dict><key>include</key><string>#directives</string></dict><dict><key>include</key><string>#instructions</string></dict></array><key>repository</key><dict><key>comments</key><dict><key>patterns</key><array><dict><key>begin</key><string>(?i:^\s*COMMENT\s+([^\w\s]))</string><key>end</key><string>\1</string><key>name</key><string>comment.block.esp</string></dict><dict><key>match</key><string>;.*$</string><key>name</key><string>comment.line.semicolon.esp</string></dict></array></dict><key>directives</key><dict><key>patterns</key><array><dict><key>match</key><string>(?i:\b(?:proc|endp|method|endm|class|endc|segment|ends|struct|record|union|enum|etype|typedef|end|public|extern|global|include|incbin|equ|macro|local|exitm|rept|irp|irpc|if|ifdef|ifndef|ife|ifidn|ifdif|else|elseif|endif|assert|uses|enter|leave|resource|lmem|chunk|endc|vardata|message|static|super|callmod|db|dw|dd|byte|word|dword|fptr|sptr|nptr|lptr|optr|handle|offset|mask|length|size|type|dup|align|even|org|assume|group|near|far)\b)</string><key>name</key><string>keyword.control.directive.esp</string></dict><dict><key>match</key><string>(?i:^\s*(?:\.8086|\.8