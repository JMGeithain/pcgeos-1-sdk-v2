<dict><key>fileTypes</key><array><string>ui</string><string>uih</string></array><key>name</key><string>PC/GEOS ESPIRE/UIC</string><key>patterns</key><array><dict><key>begin</key><string>/\*</string><key>end</key><string>\*/</string><key>name</key><string>comment.block.geos</string></dict><dict><key>match</key><string>//.*$</string><key>name</key><string>comment.line.double-slash.geos</string></dict><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>"</string><key>end</key><string>"</string><key>name</key><string>string.quoted.double.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|""</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>'</string><key>end</key><string>'</string><key>name</key><string>string.quoted.single.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|''</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict><dict><key>match</key><string>^\s*#\s*(?:include|define|undef|if|ifdef|ifndef|elif|else|endif|error|pragma|line)\b</string><key>name</key><string>meta.preprocessor.geos</string></dict><dict><key>match</key><string>\b(?:MSG|METHOD|ATTR|HINT|FID|MANUFACTURER_ID|C|CLASSF|GF|HF|VDF|MF)_[A-Z0-9_]+\b</string><key>name</key><string>constant.other.symbol.geos</string></dict><dict><key>match</key><string>(?i:\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|[0-7]+[oq]|[0-9]+d?|[0-9]+\.[0-9]+)\b)</string><key>name</key><string>constant.numeric.geos</string></dict><dict><key>match</key><string>\b(?:start|end|class|object|resource|visMoniker|list|gstring|chunk|data|structure|export|extern|include|specificUI|hints|children|output|process|link|activeList|gcnList|keyboardAccelerator)\b</string><key>name</key><string>keyword.control.uic</string></dict><dict><key>match</key><string>\b(?:Gen|Vis|Meta)[A-Za-z0-9_]*(?:Class)?\b</string><key>name</key><string>entity.name.type.geos</string></dict><dict><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*=\s*[A-Za-z_])</string><key>name</key><string>entity.name.object.uic</string></dict><dict><key>match</key><string>[=|&amp;+*/&lt;&gt;-]</string><key>name</key><string>keyword.operator.assignment.geos</string></dict><dict><key>match</key><string>;</string><key>name</key><string>punctuation.terminator.statement.geos</string></dict></array><key>scopeName</key><string>source.geos.ui</string><key>uuid</key><string>d4bbff28-ef3a-5795-a497-6f2ebb31d724</string></dict>
