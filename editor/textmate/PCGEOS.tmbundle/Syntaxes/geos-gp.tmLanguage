<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict><key>fileTypes</key><array><string>gp</string></array><key>name</key><string>PC/GEOS Glue parameters</string><key>patterns</key><array><dict><key>match</key><string>#.*$</string><key>name</key><string>comment.line.number-sign.gp</string></dict><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>"</string><key>end</key><string>"</string><key>name</key><string>string.quoted.double.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|""</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>'</string><key>end</key><string>'</string><key>name</key><string>string.quoted.single.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|''</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict><dict><key>match</key><string>(?i:\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|[0-7]+[oq]|[0-9]+d?|[0-9]+\.[0-9]+)\b)</string><key>name</key><string>constant.numeric.geos</string></dict><dict><key>match</key><string>(?i:^\s*(?:name|longname|type|class|appobj|tokenchars|tokenid|library|driver|resource|export|publish|entry|heapspace|stack|nosort|platform|protocol|usernotes|copyright|exempt|ship|incminor|ifdef|ifndef|else|endif)\b)</string><key>name</key><string>keyword.control.directive.gp</string></dict><dict><key>match</key><string>(?i:\b(?:appl|process|single|library|driver|system|ui-object|object|lmem|data|code|fixed|shared|read-only|discardable|discard-only|preload|swap-only|conforming|no-discard)\b)</string><key>name</key><string>storage.modifier.resource.gp</string></dict></array><key>scopeName</key><string>source.geos.gp</string><key>uuid</key><string>fb159a80-c0a4-5f6f-9666-8dd188a95dd0</string></dict>
</plist>
