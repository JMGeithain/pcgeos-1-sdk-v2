<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict><key>fileTypes</key><array><string>nasm</string></array><key>name</key><string>PC/GEOS NASM flat assembly</string><key>patterns</key><array><dict><key>match</key><string>;.*$</string><key>name</key><string>comment.line.semicolon.nasm</string></dict><dict><key>include</key><string>#strings</string></dict><dict><key>match</key><string>^\s*%(?:define|xdefine|assign|include|macro|imacro|endmacro|rep|endrep|if|ifdef|ifndef|elif|else|endif|error|warning|undef|push|pop|local|rotate)\b</string><key>name</key><string>keyword.control.preprocessor.nasm</string></dict><dict><key>match</key><string>(?i:\b(?:bits|cpu|org|section|segment|global|extern|align|alignb|times|equ|db|dw|dd|dq|dt|resb|resw|resd|resq|rest|incbin|struc|endstruc)\b)</string><key>name</key><string>keyword.control.directive.nasm</string></dict><dict><key>match</key><string>^\s*[A-Za-z_.$?@][\w.$?@]*:</string><key>name</key><string>entity.name.label.nasm</string></dict><dict><key>include</key><string>#numbers</string></dict><dict><key>include</key><string>#instructions</string></dict></array><key>repository</key><dict><key>instructions</key><dict><key>patterns</key><array><dict><key>match</key><string>(?i:\b(?:aaa|aad|aam|aas|adc|add|and|call|cbw|clc|cld|cli|cmc|cmp|cmpsb|cmpsw|cwd|daa|das|dec|div|esc|hlt|idiv|imul|in|inc|int|into|iret|ja|jae|jb|jbe|jc|jcxz|je|jg|jge|jl|jle|jmp|jna|jnae|jnb|jnbe|jnc|jne|jng|jnge|jnl|jnle|jno|jnp|jns|jnz|jo|jp|jpe|jpo|js|jz|lahf|lds|lea|les|lodsb|lodsw|loop|loope|loopne|loopnz|loopz|mov|movsb|movsw|mul|neg|nop|not|or|out|pop|popf|push|pushf|rcl|rcr|rep|repe|repne|repnz|repz|ret|retn|retf|rol|ror|sahf|sal|sar|sbb|scasb|scasw|shl|shr|stc|std|sti|stosb|stosw|sub|test|wait|xchg|xlat|xor)\b)</string><key>name</key><string>keyword.control.instruction.x86</string></dict></array></dict><key>numbers</key><dict><key>patterns</key><array><dict><key>match</key><string>(?i:\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|[0-7]+[oq]|[0-9]+d?|[0-9]+\.[0-9]+)\b)</string><key>name</key><string>constant.numeric.geos</string></dict></array></dict><key>strings</key><dict><key>patterns</key><array><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>"</string><key>end</key><string>"</string><key>name</key><string>string.quoted.double.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|""</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict><dict><key>applyEndPatternLast</key><true/><key>begin</key><string>'</string><key>end</key><string>'</string><key>name</key><string>string.quoted.single.geos</string><key>patterns</key><array><dict><key>match</key><string>\\.|''</string><key>name</key><string>constant.character.escape.geos</string></dict></array></dict></array></dict></dict><key>scopeName</key><string>source.geos.nasm</string><key>uuid</key><string>610dbc7f-8328-5fda-98ee-635079ee62d1</string></dict>
