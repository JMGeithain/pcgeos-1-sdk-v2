{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PC/GEOS ESP assembly",
  "scopeName": "source.geos.esp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "name": "entity.name.function.esp",
      "match": "^\\s*[A-Za-z_?$@][\\w?$@]*(?=\\s+(?i:proc|method)\\b)"
    },
    {
      "name": "entity.name.type.esp",
      "match": "^\\s*[A-Za-z_?$@][\\w?$@]*(?=\\s+(?i:class|struct|record|segment)\\b)"
    },
    {
      "name": "entity.name.label.esp",
      "match": "^\\s*[A-Za-z_?$@][\\w?$@]*:{1,2}"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#instructions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.esp",
          "begin": "(?i:^\\s*COMMENT\\s+([^\\w\\s]))",
          "end": "\\1"
        },
        {
          "name": "comment.line.semicolon.esp",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.geos",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.geos",
              "match": "\\\\.|\"\""
            }
          ],
          "applyEndPatternLast": true
        },
        {
          "name": "string.quoted.single.geos",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.geos",
              "match": "\\\\.|''"
            }
          ],
          "applyEndPatternLast": true
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.geos",
          "match": "(?i:\\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|[0-7]+[oq]|[0-9]+d?|[0-9]+\\.[0-9]+)\\b)"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.geos",
          "match": "\\b(?:MSG|METHOD|ATTR|HINT|FID|MANUFACTURER_ID|C|CLASSF|GF|HF|VDF|MF)_[A-Z0-9_]+\\b"
        },
        {
          "name": "support.type.register.x86",
          "match": "(?i:\\b(?:ax|bx|cx|dx|si|di|bp|sp|al|ah|bl|bh|cl|ch|dl|dh|cs|ds|es|ss|ip|flags)\\b)"
        },
        {
          "name": "support.type.register.later-x86",
          "match": "(?i:\\b(?:e(?:ax|bx|cx|dx|si|di|bp|sp|ip)|fs|gs)\\b)"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.esp",
          "match": "(?i:\\b(?:proc|endp|method|endm|class|endc|segment|ends|struct|record|union|enum|etype|typedef|end|public|extern|global|include|incbin|equ|macro|local|exitm|rept|irp|irpc|if|ifdef|ifndef|ife|ifidn|ifdif|else|elseif|endif|assert|uses|enter|leave|resource|lmem|chunk|endc|vardata|message|static|super|callmod|db|dw|dd|byte|word|dword|fptr|sptr|nptr|lptr|optr|handle|offset|mask|length|size|type|dup|align|even|org|assume|group|near|far)\\b)"
        },
        {
          "name": "keyword.control.directive.asm",
          "match": "(?i:^\\s*(?:\\.8086|\\.8087|\\.186|\\.286|\\.386|\\.model|\\.code|\\.data|\\.stack|bits|cpu|section|global)\\b)"
        },
        {
          "name": "meta.preprocessor.asm",
          "match": "^\\s*%\\s*(?:include|define|if|ifdef|ifndef|else|endif|macro|endmacro)\\b"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.instruction.x86",
          "match": "(?i:\\b(?:aaa|aad|aam|aas|adc|add|and|call|cbw|clc|cld|cli|cmc|cmp|cmpsb|cmpsw|cwd|daa|das|dec|div|esc|hlt|idiv|imul|in|inc|int|into|iret|ja|jae|jb|jbe|jc|jcxz|je|jg|jge|jl|jle|jmp|jna|jnae|jnb|jnbe|jnc|jne|jng|jnge|jnl|jnle|jno|jnp|jns|jnz|jo|jp|jpe|jpo|js|jz|lahf|lds|lea|les|lodsb|lodsw|loop|loope|loopne|loopnz|loopz|mov|movsb|movsw|mul|neg|nop|not|or|out|pop|popf|push|pushf|rcl|rcr|rep|repe|repne|repnz|repz|ret|retn|retf|rol|ror|sahf|sal|sar|sbb|scasb|scasw|shl|shr|stc|std|sti|stosb|stosw|sub|test|wait|xchg|xlat|xor)\\b)"
        }
      ]
    }
  }
}
