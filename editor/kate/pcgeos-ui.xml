<language name="PC/GEOS UI" section="Other" extensions="*.ui;*.uih" version="1" kateversion="5.0" author="PC/GEOS SDK contributors" license="MIT" mimetype="text/x-pcgeos-ui" priority="0">
  <highlighting>
    <list name="Directives">
      <item>include</item>
      <item>object</item>
      <item>endObject</item>
      <item>chunk</item>
      <item>endChunk</item>
      <item>resource</item>
      <item>endResource</item>
      <item>moniker</item>
      <item>endMoniker</item>
      <item>class</item>
      <item>endClass</item>
      <item>flags</item>
      <item>vardata</item>
      <item>byte</item>
      <item>word</item>
      <item>dword</item>
      <item>char</item>
      <item>string</item>
      <item>localize</item>
      <item>specificUI</item>
      <item>handle</item>
      <item>optr</item>
      <item>hint</item>
      <item>children</item>
      <item>composite</item>
      <item>link</item>
      <item>visMoniker</item>
      <item>accelerator</item>
      <item>action</item>
      <item>destination</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars char="/" char1="/" attribute="Comment" context="Comment" />
        <Detect2Chars char="/" char1="*" attribute="Comment" context="Block Comment" />
        <DetectChar char="&quot;" attribute="String" context="String" />
        <DetectChar char="'" attribute="String" context="Char" />
        <RegExpr String="@[A-Za-z_][A-Za-z0-9_]*" attribute="Directive" context="#stay" />
        <keyword String="Directives" attribute="Directive" context="#stay" />
        <RegExpr String="\bE12_[A-Za-z0-9_]+\b" attribute="API Symbol" context="#stay" />
        <RegExpr String="(?i)\b(?:0x[0-9a-f]+|[0-9][0-9a-f]*h|[01]+b|[0-9]+)\b" attribute="Number" context="#stay" />
      </context>
      <context name="Comment" attribute="Comment" lineEndContext="#pop" />
      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="Escape" context="#stay" />
        <DetectChar char="&quot;" attribute="String" context="#pop" />
      </context>
      <context name="Char" attribute="String" lineEndContext="#pop">
        <RegExpr String="\\." attribute="Escape" context="#stay" />
        <DetectChar char="'" attribute="String" context="#pop" />
      </context>
      <context name="Block Comment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars char="*" char1="/" attribute="Comment" context="#pop" />
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal" />
      <itemData name="Comment" defStyleNum="dsComment" />
      <itemData name="String" defStyleNum="dsString" />
      <itemData name="Escape" defStyleNum="dsSpecialChar" />
      <itemData name="Directive" defStyleNum="dsPreprocessor" />
      <itemData name="Instruction" defStyleNum="dsKeyword" />
      <itemData name="Register" defStyleNum="dsDataType" />
      <itemData name="API Symbol" defStyleNum="dsFunction" />
      <itemData name="Number" defStyleNum="dsDecVal" />
    </itemDatas>
  </highlighting>
  <general>
    <keywords casesensitive="false" />
    <comments>
      <comment name="singleLine" start="//" />
      <comment name="multiLine" start="/*" end="*/" />
    </comments>
  </general>
</language>
