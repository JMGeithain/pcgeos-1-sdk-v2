use strict;use warnings;use Test::More;use FindBin;use lib "$FindBin::Bin/../../tools/lib",$FindBin::Bin;
use Fixture;use File::Temp qw(tempdir);use JSON::PP;use IPC::Open3;use Symbol qw(gensym);use PCGEOS::Geos1::Profile qw(build_profile);use PCGEOS::Geos1::Format qw(parse_file);
my $dir=tempdir(CLEANUP=>1);my $cli="$FindBin::Bin/../../tools/geos1/cli.pl";
sub run_cli {my @args=@_;my $err=gensym;my $pid=open3(my $in,my $out,$err,$^X,$cli,@args);close$in;my $stdout=do{local$/;<$out>//''};my $stderr=do{local$/;<$err>//''};waitpid($pid,0);return($?>>8,$stdout,$stderr);}
my $source=writebytes("$dir/A.GEO",fixture());my($status,$stdout,$stderr)=run_cli('inspect',$source,'--output',"$dir/report.json");is($status,0,'inspect CLI status');ok(!decode_json(readbytes("$dir/report.json"))->{runtime_tested},'inspect scope');
($status,$stdout,$stderr)=run_cli('extract',$source,'--resource',2,'--output',"$dir/code.bin");is($status,0,'extract status');is(readbytes("$dir/code.bin"),"\x01\xd8\xcb",'extract exact code');
for my $number(2,999){my $before=readbytes($source);($status,$stdout,$stderr)=run_cli('extract',$source,'--resource',$number,'--output',$source);is($status,2,'input overwrite/bad resource status');is(readbytes($source),$before,'extract preserves source');}
my $modern=fixture();substr($modern,0,4)=pack('H*','c745c153');my $bad=writebytes("$dir/modern.geo",$modern);($status,$stdout,$stderr)=run_cli('inspect',$bad);is($status,2,'modern binary status');like($stderr,qr/2.x/,'modern binary diagnostic');unlike($stderr,qr/Traceback| at .* line /,'concise CLI error');
my $profile=writebytes("$dir/profile.json",JSON::PP->new->encode(build_profile([$source])));my $before=readbytes($source);my $pb=readbytes($profile);
for my $command(['inspect',$source,'--output',$source],['profile',$source,'--output',$source],['check-imports',$source,'--profile',$profile,'--output',$source],['check-imports',$source,'--profile',$profile,'--output',$profile]){($status,$stdout,$stderr)=run_cli(@$command);is($status,2,'JSON output cannot overwrite input');is(readbytes($source),$before,'binary preserved');is(readbytes($profile),$pb,'profile preserved');}
SKIP:{skip 'hardlinks unavailable',2 unless link($source,"$dir/alias.json");($status,$stdout,$stderr)=run_cli('inspect',$source,'--output',"$dir/alias.json");is($status,2,'hardlink alias protected');is(readbytes($source),$before,'hardlinked source preserved');}
my $broken=writebytes("$dir/B.GEO",'bad');($status,$stdout,$stderr)=run_cli('profile',$source,$broken,'--keep-going');is($status,1,'incomplete profile nonzero status');ok(!decode_json($stdout)->{complete_for_supplied_paths},'CLI profile marked incomplete');
my $raw=fixture();substr($raw,0xcc,4)=pack('v2',0,0);my $unbound=writebytes("$dir/unbound.geo",$raw);($status,$stdout,$stderr)=run_cli('bind-kernel',$unbound,'--reference',$source,'--output',"$dir/bound.geo");is($status,0,'bind CLI');is(decode_json($stdout)->{output_sha256},parse_file("$dir/bound.geo")->{sha256},'binding emits provenance hash');
done_testing;
