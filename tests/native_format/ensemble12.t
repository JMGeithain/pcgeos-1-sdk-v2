use PCGEOS::Ensemble12::Build qw(_metadata _validate_calls _dgroup build_project); use PCGEOS::Ensemble12::Objects qw(build_objects object_block);
sub packet {my %o=(code=>"\x9a\xd3\0\0\0\xcb",methods=>[[73,0]],relocations=>[[0,0,1]],@_);my $m=join('',map{pack('v2',@$_)}@{$o{methods}});my $r=join('',map{pack('CCv',@$_)}@{$o{relocations}});$o{code}.$m.$r.pack('a8v4','G1META01',length($o{code}),length($m),length($r),1);}
my $code="\x9a\xd3\0\0\0\xcb\x9a\x9a\x01\x02\x03\x04";my($decoded,$methods,$relocs)=_metadata(packet(code=>$code));is($decoded,$code,'explicit metadata does not scan incidental opcodes');is_deeply($methods,[[73,0]],'method records');is_deeply($relocs,[[0,0,1]],'relocation records');ok(eval{_validate_calls($decoded,$relocs,1);1},'kernel call valid');
my $valid=packet();for my $bad('',substr($valid,0,-1),substr($valid,0,-16).pack('a8v4','WRONG001',6,4,4,1),substr($valid,0,-16).pack('a8v4','G1META01',6,4,4,2),substr($valid,0,-16).pack('a8v4','G1META01',7,4,4,1),substr($valid,0,-16).pack('a8v4','G1META01',6,3,5,1)){dies_like(sub{_metadata($bad)},qr/./,'bad metadata footer');}
for my $m([],[[73,0],[73,1]],[[73,6]]){dies_like(sub{_metadata(packet(methods=>$m))},qr/./,'invalid methods');}
dies_like(sub{_metadata(packet(relocations=>[[0,0,4]]))},qr/./,'metadata relocation fit');
for my $r([[0,0,0]],[[0,0,2]],[[0,0,5]],[[0x10,0,1]],[[0,1,1]],[[0x14,1,1]],[[0,0,1],[0,0,1]]){dies_like(sub{_validate_calls("\x9a\0\0\0\0\xcb",$r,1)},qr/./,'invalid API call');}
ok(eval{_validate_calls("\x9a\0\0\0\0\xcb",[[0x14,1,1]],2);1},'second import accepted');
my $dg=_dgroup([[73,0x12],[87,0x34]]);is(word($dg->{data},20),length($dg->{data}),'dgroup heap boundary');is(word($dg->{data},0x46),2,'handler count');is_deeply([unpack('v2',substr($dg->{data},0x52,4))],[73,87],'method table');is_deeply([unpack('v4',substr($dg->{data},0x56,8))],[0x12,2,0x34,2],'handler far pointers');is_deeply($dg->{relocations},[[0x11,0,0x40],[0x12,0,0x42],[0x22,0,0x58],[0x22,0,0x5c]],'class relocation labels');dies_like(sub{_dgroup([map{[$_,0]}0..39])},qr/./,'bounded class handlers');
my $temp=tempdir(CLEANUP=>1);make_path("$temp/app");writebytes("$temp/outside.nasm","CPU 8086\n");writebytes("$temp/app/project.json",JSON::PP->new->encode({name=>'testapp',kind=>'application',backend=>'ensemble12',cpu=>'8086',sources=>[{language=>'nasm',path=>'../outside.nasm'}]}));dies_like(sub{build_project("$temp/app","$temp/out","$temp/missing-compiler")},qr/inside the project/,'source path traversal before compiler');
sub chunks {my($d)=@_;my %out;my($table,$count)=(word($d,2),word($d,10));for(my $at=$table;$at<$table+2*$count;$at+=2){my $p=word($d,$at);next if !$p||$p==65535;$out{$at}=substr($d,$p,word($d,$p-2)-2);}return \%out;}
my $block=object_block(3,{0x24=>['abcdefg',3],0x26=>['',2]},6);is(length($block)%16,0,'heap paragraph aligned');is(word($block,0x14),length($block),'heap allocated boundary');is(word($block,0x22),65535,'allocated-empty slot');is(word($block,0x26),65535,'allocated-empty chunk');is(word($block,0x28),0,'unallocated differs');my $cs=chunks($block);for my $handle(keys%$cs){my $at=word($block,$handle);is(($at-2)%4,0,'chunk prefix aligned');is(word($block,$at-2),length($cs->{$handle})+2,'chunk size prefix');}is($cs->{0x20},pack('C6',0,2,3,2,0,0),'flags chunk');cmp_ok(word($block,8),'<=',length($block),'logical heap bounded');
my($ui,$app)=build_objects('Original title','TEST',width=>400,height=>240);my($u,$a)=(chunks($ui),chunks($app));my($primary,$view,$root)=($u->{0x24},$u->{0x28},$a->{0x24});is_deeply([unpack('v2',substr($primary,0xc,4))],[0x25,0x1004],'primary cross-block parent');is_deeply([unpack('v2',substr($primary,0x10,4))],[0x28,0x4000],'primary view child');is_deeply([unpack('v2',substr($view,0xc,4))],[0x25,0x4000],'view parent termination');is_deeply([unpack('v2',substr($root,0x10,4))],[0x24,0x1003],'root child');is_deeply([unpack('v4',$a->{0x28})],[0x24,0x1003,0,0],'optr list');is_deeply([unpack('v4',substr($view,0x32,8))],[400,240,400,240],'view requested and document geometry');is(substr($root,30,4),'TEST','app token');is(substr($u->{0x26},6),"Original title\0",'fresh text moniker');
for my $pair([63,180],[641,180],[320,63],[320,481],[3.5,180],[JSON::PP::true,180]){dies_like(sub{build_objects('Test','TEST',width=>$pair->[0],height=>$pair->[1])},qr/./,'invalid geometry');}
for my $pair([3,{}],[6,{0x25=>['x',2]}],[6,{0x2c=>['x',2]}]){dies_like(sub{object_block(3,$pair->[1],$pair->[0])},qr/./,'invalid handles');}
